{
  "name": "@midnight-ntwrk/journal-ui",
  "version": "0.1.0",
  "author": "IOG",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build --mode preprod && node -e \"const fs=require('fs');fs.mkdirSync('./dist',{recursive:true});fs.cpSync('../contract/src/managed/journal/keys','./dist/keys',{recursive:true});fs.cpSync('../contract/src/managed/journal/zkir','./dist/zkir',{recursive:true})\"",
    "build:preview": "tsc && vite build --mode preview && node -e \"const fs=require('fs');fs.mkdirSync('./dist',{recursive:true});fs.cpSync('../contract/src/managed/journal/keys','./dist/keys',{recursive:true});fs.cpSync('../contract/src/managed/journal/zkir','./dist/zkir',{recursive:true})\"",
    "build:start": "npm run build && npm run start",
    "build:start:preview": "npm run build:preview && npm run start",
    "ci": "npm run typecheck && npm run lint",
    "dev": "vite",
    "lint": "eslint ./src",
    "start": "http-server --port 0 ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.1.1",
    "node-stdlib-browser": "^1.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "7.17.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.41",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint-plugin-react": "^7.37.5",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.0.3",
    "@rollup/rollup-win32-x64-msvc": "^4.62.2"
  }
}
